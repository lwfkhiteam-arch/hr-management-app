{ "compilerOptions": { "target": "ES2020", "lib": ["dom","esnext"], "strict": true, "jsx": "preserve", "module": "esnext",
  "moduleResolution": "bundler", "noEmit": true, "esModuleInterop": true, "skipLibCheck": true, "allowJs": true,
  "resolveJsonModule": true, "isolatedModules": true, "incremental": true, "paths": { "@/*": ["./*"] }, "plugins": [{ "name": "next" }] },
  "include": ["**/*.ts","**/*.tsx"], "exclude": ["node_modules"] }
